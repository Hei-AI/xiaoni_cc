@startuml
!pragma layout smetana
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 15
skinparam ArrowColor #40526B
skinparam ArrowThickness 1.5
skinparam ComponentBorderColor #557CAD
skinparam ComponentBackgroundColor #E6EEF9
skinparam DatabaseBorderColor #557CAD
skinparam DatabaseBackgroundColor #E6EEF9
skinparam QueueBorderColor #C99008
skinparam QueueBackgroundColor #FFF2C8
skinparam NoteBorderColor #D8AD31
skinparam NoteBackgroundColor #FFF8DF

left to right direction
title 小腻 Notify Bucket 运行组件图

component "外部输入\n----\nNapCat QQ message\nself continuation\nsystem reminder" as External #DCF2EE

package "provider-service" as Provider #EDF7FF {
  component "inbound normalizer\n----\nnormalize NapCat event\nwrite inbox\nauto_reply gate\npush notify" as ProviderInbound #EDF7FF
  component "provider API\n----\nQQ outbound\nmedia materialize\nimage endpoints" as ProviderApi #EDF7FF
  component "codex-provider\n----\nLLM adapter\nOpenAI request/response" as CodexProvider #E5F7F2
  component "image provider\n----\nOpenAI / Codex\nimage transport" as ImageProvider #E5F7F2
}

database "agent_inbound_messages\n----\nQQ 正文 inbox / window" as Inbox #E6EEF9

queue "Notify Bucket\n----\n唯一概念桶" as Bucket #FFF2C8
database "agent_queue_messages\n----\n当前持久化 / lease 实现" as QueueTable #E6EEF9

package "agent-service" as AgentService #FFFDF5 {
  component "小腻 runtime loop\n----\n1 loop tick\n2 build prompt/dev\n3 append history\n4 Step 5 pick notify\n5 Step 6 combined finish\n6 Step 7 execute model POST\n7 Step 9/10 save" as RuntimeLoop #FFFDF5
  component "Step 8\nResponseActionRouter\n----\npreserve replay\nclassify final_answer / tool_call\nemit post actions" as ResponseRouter #FFF2C8
  component "ToolDispatcher\n----\nunified tool entry\nlog tool_execution_logs\nroute by tool name" as ToolDispatcher #FFF2C8
  component "qq-usage API\n----\n/api/internal/qq-usage" as QqUsage #FFFDF5
  component "image vision fork\n----\ncurrent main context\nfunction_call_output input_image\nno-persist" as ImageVisionFork #FFFDF5
  component "agent task worker\n----\nimage task\ncompletion notify" as TaskWorker #FFFDF5
}

cloud "OpenAI\n----\nassistant response\nimage generation" as OpenAI #F1ECFF

component "xiaoni-executor\n----\nexec_command\npicture store\nsession state" as Executor #E5F7F2

database "replay / conversation / trace\n----\nhistory transcript\npost-action result" as History #E6EEF9

External --> ProviderInbound : QQ inbound / trigger
ProviderInbound --> Inbox : write QQ body
ProviderInbound --> Bucket : auto_reply_enabled=true\npush phone_notification
ProviderInbound -[#607086,dashed]-> History : auto_reply_enabled=false\nskip notify, log timeline
Bucket .. QueueTable : carried by
Bucket --> RuntimeLoop : Step 5 pick, non-blocking

RuntimeLoop --> CodexProvider : Step 7\n/provider-service /agent/execute
CodexProvider --> OpenAI : LLM request
OpenAI --> CodexProvider : assistant / tool_call / final_answer
CodexProvider --> ResponseRouter : canonical_response

ResponseRouter --> History : replay / transcript plan
ResponseRouter --> Bucket : final_answer post action\nif bucket empty
ResponseRouter --> ToolDispatcher : tool_call
ResponseRouter --> RuntimeLoop : no-tool continuation

ToolDispatcher --> QqUsage : $qq-usage
QqUsage --> Inbox : read inbox window
QqUsage --> ToolDispatcher : QQ context

ToolDispatcher --> ImageVisionFork : inspect_image_placeholder
ImageVisionFork --> CodexProvider : /api/internal/llm/debug\nx-qqbot-no-traffic-persist
CodexProvider --> ImageVisionFork : image meaning text
ImageVisionFork --> ToolDispatcher : <image id=...>含义是...</image>

ToolDispatcher --> ProviderApi : QQ reply / media materialize
ProviderApi --> External : QQ outbound via NapCat

ToolDispatcher --> Executor : exec_command
Executor --> ToolDispatcher : stdout / stderr

ToolDispatcher --> TaskWorker : request_image_task
TaskWorker --> ImageProvider : provider-service image endpoint
ImageProvider --> OpenAI : image generation
OpenAI --> ImageProvider : image result
TaskWorker --> Executor : store picture
TaskWorker --> Bucket : push image completion notify

RuntimeLoop --> History : Step 9/10 save
History --> RuntimeLoop : next loop context
RuntimeLoop -[#607086,dashed]-> RuntimeLoop : next loop

note bottom of Bucket
  回灌目标是概念上的 Notify Bucket。
  agent_queue_messages 只是当前承载实现，
  不是 QQ 正文 inbox。
end note

note bottom of ResponseRouter
  final_answer 在这里消费为 post action。
  不改变历史 transcript 的 phase 渲染：
  历史存什么，出去就是什么。
end note

note bottom of ToolDispatcher
  归一的是 tool control plane，
  不是把所有 tool 都塞进 provider-service。
end note
@enduml
