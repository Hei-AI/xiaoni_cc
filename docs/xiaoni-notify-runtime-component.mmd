flowchart LR
  %% Topology-oriented source for docs/xiaoni-notify-runtime-component.svg.
  %% The PlantUML file is the rendered source; this Mermaid file keeps the same semantic graph.

  classDef external fill:#dcf2ee,stroke:#4f9d8a,color:#17202b
  classDef provider fill:#edf7ff,stroke:#4d8fcb,color:#17202b
  classDef bucket fill:#fff2c8,stroke:#c99008,stroke-width:2px,color:#17202b
  classDef agent fill:#fffdf5,stroke:#c99008,stroke-width:2px,color:#17202b
  classDef step fill:#e6eef9,stroke:#557cad,color:#17202b
  classDef tool fill:#e5f7f2,stroke:#4f9d8a,color:#17202b
  classDef llm fill:#f1ecff,stroke:#7c63c7,color:#17202b
  classDef store fill:#e6eef9,stroke:#557cad,color:#17202b
  classDef note fill:#fff8df,stroke:#d8ad31,color:#17202b

  external["外部输入<br/>NapCat QQ / self continuation / system reminder"]:::external
  bucket["Notify Bucket<br/>唯一概念桶"]:::bucket
  queue["agent_queue_messages<br/>持久化 / lease 实现"]:::store
  inbox["agent_inbound_messages<br/>QQ 正文 inbox / window"]:::store
  history["replay / conversation / trace<br/>历史与 action trace"]:::store
  openai["OpenAI<br/>assistant response / image generation"]:::llm
  executor["xiaoni-executor<br/>exec_command / picture store"]:::tool

  subgraph provider["provider-service"]
    direction TB
    providerInbound["inbound normalizer<br/>write inbox / auto_reply gate / push notify"]:::provider
    providerApi["provider API<br/>QQ outbound / media materialize / image endpoints"]:::provider
    codexProvider["codex-provider<br/>LLM adapter"]:::tool
    imageProvider["image provider<br/>OpenAI / Codex image transport"]:::tool
  end

  subgraph agent["agent-service"]
    direction TB
    loop["小腻 runtime loop<br/>Step 1-7 + Step 9/10"]:::agent
    router{"Step 8<br/>ResponseActionRouter"}:::bucket
    dispatcher{"ToolDispatcher<br/>unified tool entry"}:::bucket
    qqUsageApi["qq-usage API<br/>/api/internal/qq-usage"]:::agent
    imageVisionFork["image vision fork<br/>main context + input_image<br/>no-persist"]:::agent
    taskWorker["agent task worker<br/>image task completion"]:::agent
  end

  noteRouter["final_answer 在 router 消费为 post action<br/>transcript phase 仍按原样保存 / 回放"]:::note
  noteDispatch["归一的是 tool control plane<br/>不是所有 tool 都走 provider-service"]:::note
  noteBucket["agent_queue_messages 是承载实现<br/>不是 QQ 正文 inbox"]:::note

  external --> providerInbound
  providerInbound --> inbox
  providerInbound -- "auto_reply_enabled=true" --> bucket
  providerInbound -. "auto_reply_enabled=false: skip" .-> history
  bucket -. "carried by" .-> queue
  bucket --> loop
  bucket -.-> noteBucket

  loop --> codexProvider --> openai --> codexProvider --> router
  router --> history
  router -- "final_answer post action<br/>if bucket empty" --> bucket
  router -- "tool_call" --> dispatcher
  router -- "message / silent" --> loop
  router -.-> noteRouter

  dispatcher --> qqUsageApi --> inbox
  dispatcher --> imageVisionFork --> codexProvider
  dispatcher --> providerApi --> external
  dispatcher --> executor --> dispatcher
  dispatcher --> taskWorker --> imageProvider --> openai
  taskWorker --> executor
  taskWorker --> bucket
  dispatcher -.-> noteDispatch

  loop --> history --> loop
