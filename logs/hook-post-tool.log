ated_at.getTime()\n      const badAttempt = (cached.updated_at as any).getTime();\n    } catch (error) {\n      errorOccurred = true;\n      expect((error as Error).message).toContain('is not a function');\n    }\n    \n    expect(errorOccurred).toBe(true);\n  });\n\n  test('修复后：安全地处理string类型的updated_at', () => {\n    const cached: { updated_at: any } = {\n      updated_at: '2025-09-01T10:00:00.000Z', // 字符串类型\n      id: 'test-prompt',\n      agent_type: 'chat_bot'\n    };\n    \n    // 使用修复后的逻辑\n    let updatedAt: Date;\n    let succeeded = false;\n    \n    try {\n      if (cached.updated_at instanceof Date) {\n        updatedAt = cached.updated_at;\n      } else if (typeof cached.updated_at === 'string') {\n        updatedAt = new Date(cached.updated_at);\n        succeeded = true;\n      }\n      \n      // 验证转换成功\n      expect(succeeded).toBe(true);\n      expect(updatedAt!).toBeInstanceOf(Date);\n      expect(updatedAt!.getTime()).toBeGreaterThan(0);\n    } catch (error) {\n      fail('修复后的代码不应该抛出错误');\n    }\n  });\n\n  test('修复后：处理Date类型的updated_at', () => {\n    const cached = {\n      updated_at: new Date('2025-09-01T10:00:00.000Z'), // Date类型\n      id: 'test-prompt',\n      agent_type: 'chat_bot'\n    };\n    \n    let updatedAt: Date;\n    let succeeded = false;\n    \n    try {\n      if (cached.updated_at instanceof Date) {\n        updatedAt = cached.updated_at;\n        succeeded = true;\n      } else if (typeof cached.updated_at === 'string') {\n        updatedAt = new Date(cached.updated_at);\n      }\n      \n      expect(succeeded).toBe(true);\n      expect(updatedAt!).toBeInstanceOf(Date);\n      expect(updatedAt!.getTime()).toBeGreaterThan(0);\n    } catch (error) {\n      fail('修复后的代码不应该抛出错误');\n    }\n  });\n\n  test('修复后：处理null/undefined的updated_at', () => {\n    const cached = {\n      updated_at: null, // 无效值\n      id: 'test-prompt',\n      agent_type: 'chat_bot'\n    };\n    \n    let updatedAt: Date | undefined;\n    let shouldClearCache = false;\n    \n    try {\n      if (cached.updated_at instanceof Date) {\n        updatedAt = cached.updated_at;\n      } else if (typeof cached.updated_at === 'string') {\n        updatedAt = new Date(cached.updated_at);\n      } else {\n        // 无效的updated_at，应该清除缓存\n        shouldClearCache = true;\n      }\n      \n      expect(shouldClearCache).toBe(true);\n      expect(updatedAt).toBeUndefined();\n    } catch (error) {\n      fail('修复后的代码不应该抛出错误');\n    }\n  });\n});","structuredPatch":[{"oldStart":53,"oldLines":7,"newStart":53,"newLines":7,"lines":["   });"," ","   test('修复后：处理Date类型的updated_at', () => {","-    const cached = {","+    const cached: { updated_at: any } = {","       updated_at: new Date('2025-09-01T10:00:00.000Z'), // Date类型","       id: 'test-prompt',","       agent_type: 'chat_bot'"]}],"userModified":false,"replaceAll":false}}
