ror('Failed to refresh conversations:', error);\n                addLogEntry('error', '对话记录加载失败: ' + error.message);\n                \n                document.getElementById('conversations-container').innerHTML = \n                    '<div class=\"log-entry log-error\">对话记录加载失败，请检查服务器状态</div>';\n            }\n        }\n        \n        // 初始化\n        document.addEventListener('DOMContentLoaded', function() {\n            refreshStatus();\n            refreshConversations(); // 初始加载对话记录\n            setInterval(updateUptime, 1000);  // 每秒更新运行时间\n            setInterval(refreshStatus, 30000); // 每30秒刷新状态\n            \n            addLogEntry('info', 'Dashboard初始化完成');\n        });","originalFile":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>QQ智能机器人 - Dashboard</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            min-height: 100vh;\n            color: #333;\n        }\n        \n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n        \n        .header {\n            text-align: center;\n            margin-bottom: 40px;\n            color: white;\n        }\n        \n        .header h1 {\n            font-size: 2.5rem;\n            margin-bottom: 10px;\n        }\n        \n        .status-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 20px;\n            margin-bottom: 40px;\n        }\n        \n        .card {\n            background: rgba(255, 255, 255, 0.95);\n            border-radius: 15px;\n            padding: 25px;\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n        \n        .card h3 {\n            margin-bottom: 15px;\n            color: #4a5568;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n        \n        .status-indicator {\n            width: 12px;\n            height: 12px;\n            border-radius: 50%;\n            display: inline-block;\n        }\n        \n        .status-healthy {\n            background-color: #48bb78;\n        }\n        \n        .status-warning {\n            background-color: #ed8936;\n        }\n        \n        .status-error {\n            background-color: #e53e3e;\n        }\n        \n        .metric {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 10px;\n            padding: 8px 0;\n            border-bottom: 1px solid #e2e8f0;\n        }\n        \n        .metric:last-child {\n            border-bottom: none;\n        }\n        \n        .api-section {\n            background: rgba(255, 255, 255, 0.95);\n            border-radius: 15px;\n            padding: 25px;\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }\n        \n        .api-endpoint {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 10px;\n            margin: 5px 0;\n            background: #f7fafc;\n            border-radius: 8px;\n            border-left: 4px solid #4299e1;\n        }\n        \n        .method {\n            background: #4299e1;\n            color: white;\n            padding: 4px 8px;\n            border-radius: 4px;\n            font-size: 0.8rem;\n            font-weight: bold;\n        }\n        \n        .method.post {\n            background: #48bb78;\n        }\n        \n        .refresh-btn {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            border: none;\n            padding: 12px 24px;\n            border-radius: 8px;\n            cursor: pointer;\n            font-size: 16px;\n            transition: transform 0.2s;\n            margin-bottom: 20px;\n        }\n        \n        .refresh-btn:hover {\n            transform: translateY(-2px);\n        }\n        \n        .logs-section {\n            background: rgba(255, 255, 255, 0.95);\n            border-radius: 15px;\n            padding: 25px;\n            margin-top: 20px;\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        }\n        \n        .log-entry {\n            padding: 8px 12px;\n            margin: 4px 0;\n            border-radius: 6px;\n            font-family: 'Monaco', 'Menlo', monospace;\n            font-size: 14px;\n        }\n        \n        .log-info {\n            background: #e6f3ff;\n            border-left: 4px solid #4299e1;\n        }\n        \n        .log-warn {\n            background: #fef5e7;\n            border-left: 4px solid #ed8936;\n        }\n        \n        .log-error {\n            background: #fed7d7;\n            border-left: 4px solid #e53e3e;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>🤖 QQ智能机器人</h1>\n            <p>基于TypeScript的智能对话和需求管理系统</p>\n        </div>\n        \n        <button class=\"refresh-btn\" onclick=\"refreshStatus()\">🔄 刷新状态</button>\n        \n        <div class=\"status-grid\">\n            <div class=\"card\">\n                <h3>\n                    <span class=\"status-indicator\" id=\"system-indicator\"></span>\n                    系统状态\n                </h3>\n                <div class=\"metric\">\n                    <span>WebSocket连接</span>\n                    <span id=\"websocket-status\">-</span>\n                </div>\n                <div class=\"metric\">\n                    <span>数据库连接</span>\n                    <span id=\"database-status\">-</span>\n                </div>\n                <div class=\"metric\">\n                    <span>HTTP服务器</span>\n                    <span id=\"http-status\">运行中</span>\n                </div>\n                <div class=\"metric\">\n                    <span>最后更新</span>\n                    <span id=\"last-update\">-</span>\n                </div>\n            </div>\n            \n            <div class=\"card\">\n                <h3>\n                    <span class=\"status-indicator status-healthy\"></span>\n                    运行指标\n                </h3>\n                <div class=\"metric\">\n                    <span>运行时间</span>\n                    <span id=\"uptime\">计算中...</span>\n                </div>\n                <div class=\"metric\">\n                    <span>内存使用</span>\n                    <span id=\"memory-usage\">-</span>\n                </div>\n                <div class=\"metric\">\n                    <span>CPU使用率</span>\n                    <span id=\"cpu-usage\">-</span>\n                </div>\n                <div class=\"metric\">\n                    <span>Node.js版本</span>\n                    <span id=\"node-version\">-</span>\n                </div>\n            </div>\n            \n            <div class=\"card\">\n                <h3>\n                    <span class=\"status-indicator status-healthy\"></span>\n                    机器人信息\n                </h3>\n                <div class=\"metric\">\n                    <span>机器人QQ号</span>\n                    <span>1129974489</span>\n                </div>\n                <div class=\"metric\">\n                    <span>授权用户</span>\n                    <span>85178516</span>\n                </div>\n                <div class=\"metric\">\n                    <span>AI模型</span>\n                    <span>Gemini Pro</span>\n                </div>\n                <div class=\"metric\">\n                    <span>协议版本</span>\n                    <span>OneBot 11</span>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"api-section\">\n            <h3>🔗 API接口文档</h3>\n            <div class=\"api-endpoint\">\n                <div>\n                    <span class=\"method\">GET</span>\n                    <span>/health</span>\n                </div>\n                <span>健康检查</span>\n            </div>\n            <div class=\"api-endpoint\">\n                <div>\n                    <span class=\"method\">GET</span>\n                    <span>/api/status</span>\n                </div>\n                <span>系统状态详情</span>\n            </div>\n            <div class=\"api-endpoint\">\n                <div>\n                    <span class=\"method post\">POST</span>\n                    <span>/api/send_private</span>\n                </div>\n                <span>发送私聊消息</span>\n            </div>\n            <div class=\"api-endpoint\">\n                <div>\n                    <span class=\"method post\">POST</span>\n                    <span>/api/send_group</span>\n                </div>\n                <span>发送群聊消息</span>\n            </div>\n            <div class=\"api-endpoint\">\n                <div>\n                    <span class=\"method\">GET</span>\n                    <span>/api/conversations</span>\n                </div>\n                <span>对话历史查询</span>\n            </div>\n            <div class=\"api-endpoint\">\n                <div>\n                    <span class=\"method\">GET</span>\n                    <span>/api/requirements</span>\n                </div>\n                <span>需求管理状态</span>\n            </div>\n        </div>\n        \n        <div class=\"logs-section\">\n            <h3>💬 历史对话记录</h3>\n            <div class=\"conversations-controls\">\n                <button class=\"refresh-btn\" onclick=\"refreshConversations()\" style=\"margin-bottom: 10px; padding: 8px 16px; font-size: 14px;\">🔄 刷新对话</button>\n                <select id=\"user-filter\" onchange=\"refreshConversations()\" style=\"margin-left: 10px; padding: 8px; border-radius: 4px; border: 1px solid #ccc;\">\n                    <option value=\"\">所有用户</option>\n                    <option value=\"85178516\">授权用户 (85178516)</option>\n                </select>\n            </div>\n            <div id=\"conversations-container\">\n                <div class=\"log-entry log-info\">\n                    正在加载历史对话记录...\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"logs-section\">\n            <h3>📝 实时日志</h3>\n            <div id=\"log-container\">\n                <div class=\"log-entry log-info\">\n                    [INFO] Dashboard加载完成 - 正在获取系统状态...\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        let startTime = Date.now();\n        \n        function formatUptime(ms) {\n            const seconds = Math.floor(ms / 1000);\n            const minutes = Math.floor(seconds / 60);\n            const hours = Math.floor(minutes / 60);\n            const days = Math.floor(hours / 24);\n            \n            if (days > 0) return `${days}天 ${hours % 24}小时`;\n            if (hours > 0) return `${hours}小时 ${minutes % 60}分钟`;\n            if (minutes > 0) return `${minutes}分钟 ${seconds % 60}秒`;\n            return `${seconds}秒`;\n        }\n        \n        function formatMemory(bytes) {\n            const mb = bytes / (1024 * 1024);\n            return mb.toFixed(1) + ' MB';\n        }\n        \n        function addLogEntry(level, message) {\n            const container = document.getElementById('log-container');\n            const entry = document.createElement('div');\n            entry.className = `log-entry log-${level}`;\n            entry.textContent = `[${level.toUpperCase()}] ${new Date().toLocaleTimeString()} - ${message}`;\n            container.appendChild(entry);\n            \n            // 只保留最后10条日志\n            while (container.children.length > 10) {\n                container.removeChild(container.firstChild);\n            }\n        }\n        \n        async function refreshStatus() {\n            try {\n                addLogEntry('info', '正在刷新系统状态...');\n                \n                // 获取健康状态\n                const healthResponse = await fetch('/health');\n                const healthData = await healthResponse.json();\n                \n                // 获取详细状态\n                const statusResponse = await fetch('/api/status');\n                const statusData = await statusResponse.json();\n                \n                // 更新系统状态指示器\n                const indicator = document.getElementById('system-indicator');\n                if (healthData.status === 'healthy') {\n                    indicator.className = 'status-indicator status-healthy';\n                } else {\n                    indicator.className = 'status-indicator status-error';\n                }\n                \n                // 更新状态信息\n                document.getElementById('websocket-status').textContent = \n                    healthData.websocket_connected ? '✅ 已连接' : '❌ 断开';\n                document.getElementById('database-status').textContent = \n                    healthData.database_connected ? '✅ 已连接' : '❌ 断开';\n                document.getElementById('last-update').textContent = \n                    new Date(healthData.timestamp).toLocaleTimeString();\n                \n                // 更新详细状态\n                if (statusData.system_info) {\n                    document.getElementById('memory-usage').textContent = \n                        formatMemory(statusData.system_info.memory_usage);\n                    document.getElementById('cpu-usage').textContent = \n                        statusData.system_info.cpu_usage + '%';\n                    document.getElementById('node-version').textContent = \n                        statusData.system_info.node_version;\n                }\n                \n                addLogEntry('info', '系统状态更新成功');\n                \n            } catch (error) {\n                console.error('Failed to refresh status:', error);\n                addLogEntry('error', '状态更新失败: ' + error.message);\n                \n                // 设置错误状态\n                document.getElementById('system-indicator').className = 'status-indicator status-error';\n                document.getElementById('websocket-status').textContent = '❓ 未知';\n                document.getElementById('database-status').textContent = '❓ 未知';\n            }\n        }\n        \n        // 更新运行时间\n        function updateUptime() {\n            const uptime = Date.now() - startTime;\n            document.getElementById('uptime').textContent = formatUptime(uptime);\n        }\n        \n        // 初始化\n        document.addEventListener('DOMContentLoaded', function() {\n            refreshStatus();\n            setInterval(updateUptime, 1000);  // 每秒更新运行时间\n            setInterval(refreshStatus, 30000); // 每30秒刷新状态\n            \n            addLogEntry('info', 'Dashboard初始化完成');\n        });\n    </script>\n</body>\n</html>","structuredPatch":[{"oldStart":411,"oldLines":9,"newStart":411,"newLines":74,"lines":["             document.getElementById('uptime').textContent = formatUptime(uptime);","         }","         ","+        // 刷新对话记录","+        async function refreshConversations() {","+            try {","+                addLogEntry('info', '正在刷新对话记录...');","+                ","+                const userFilter = document.getElementById('user-filter').value;","+                let url = '/api/conversations?limit=20';","+                if (userFilter) {","+                    url += `&user_id=${userFilter}`;","+                }","+                ","+                const response = await fetch(url);","+                const data = await response.json();","+                ","+                const container = document.getElementById('conversations-container');","+                container.innerHTML = '';","+                ","+                if (data.success && data.data && data.data.length > 0) {","+                    data.data.forEach(conv => {","+                        const convElement = document.createElement('div');","+                        convElement.className = 'conversation-item';","+                        convElement.style.cssText = `","+                            border: 1px solid #e2e8f0;","+                            border-radius: 8px;","+                            padding: 15px;","+                            margin: 10px 0;","+                            background: #f8f9fa;","+                        `;","+                        ","+                        const timeStr = new Date(conv.timestamp || conv.created_at).toLocaleString('zh-CN');","+                        const responseTime = conv.response_time ? ` (${conv.response_time}ms)` : '';","+                        ","+                        convElement.innerHTML = `","+                            <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">","+                                <strong>用户 ${conv.user_id}</strong>","+                                <span style=\"color: #666; font-size: 12px;\">${timeStr}${responseTime}</span>","+                            </div>","+                            <div style=\"background: #e3f2fd; padding: 8px; border-radius: 4px; margin-bottom: 8px;\">","+                                <strong>用户:</strong> ${conv.user_message || '(空消息)'}","+                            </div>","+                            <div style=\"background: #f3e5f5; padding: 8px; border-radius: 4px;\">","+                                <strong>AI回复:</strong> ${conv.ai_response || '(无回复)'}","+                            </div>","+                            ${conv.model_name ? `<div style=\"font-size: 11px; color: #888; margin-to