  const result = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      expect(result).toBeDefined();\n    });\n  });\n});\n\n// 集成测试：验证完整的AI服务工作流程\ndescribe('AI Service Integration Test - Post Fix', () => {\n  test('should process conversation without cached date errors', async () => {\n    // 这个测试需要真实的数据库连接，但可以作为手动集成测试的参考\n\n    // 1. 发送测试消息\n    // curl -X POST http://localhost:8080/api/send_private \\\n    //   -H \"Content-Type: application/json\" \\\n    //   -d '{\"user_id\": 85178516, \"message\": \"测试修复后的AI回复\"}'\n\n    // 2. 验证响应不是\"无法处理\"\n    // curl 'http://localhost:8080/api/conversations?user_id=85178516&limit=1'\n\n    // 3. 检查日志中没有getTime错误\n    // tail logs/ai-service_$(date +%Y-%m-%d).log | grep -v \"getTime is not a function\"\n\n    expect(true).toBe(true); // 占位符，实际需要集成环境运行\n  });\n});\n\nexport {};"},"tool_response":{"type":"create","filePath":"/home/liahua/IdeaProject/qq_bot/tests/ai-service-cache-fix.test.ts","content":"import { AIService } from '../src/services/ai-service';\nimport { DatabaseManager } from '../src/services/database';\nimport { AIConfig, AgentPromptData } from '../src/types';\nimport { jest } from '@jest/globals';\n\ndescribe('AI Service Cache Date Handling Fix', () => {\n  let aiService: AIService;\n  let mockDatabase: jest.Mocked<DatabaseManager>;\n  let mockConfig: AIConfig;\n\n  beforeEach(() => {\n    // Mock配置\n    mockConfig = {\n      model_name: 'gemini-2.5-flash',\n      api_keys: ['test-key'],\n      authorized_user_id: 85178516,\n      bot_qq_number: 1129974489\n    };\n\n    // Mock数据库\n    mockDatabase = {\n      getAgentPrompt: jest.fn(),\n      saveAgentPrompt: jest.fn(),\n      getAgentPrompts: jest.fn(),\n    } as any;\n\n    // 创建AI服务实例\n    aiService = new AIService(mockConfig, mockDatabase);\n  });\n\n  describe('Agent Prompt Cache Date Handling', () => {\n    test('should handle string date from database', async () => {\n      // 模拟数据库返回字符串格式的日期\n      const mockPromptWithStringDate: AgentPromptData = {\n        id: 'test-id',\n        agent_type: 'chat_bot',\n        prompt_name: 'default_chat',\n        system_instructions: ['Test instruction'],\n        model_config: {\n          temperature: 0.7,\n          topK: 40,\n          topP: 0.95,\n          maxOutputTokens: 4096\n        },\n        is_active: true,\n        version: 1,\n        created_by: 'system',\n        created_at: new Date('2025-09-01T10:00:00.000Z'),\n        updated_at: '2025-09-01T10:00:00.000Z' as any, // 模拟字符串格式\n        description: 'Test prompt'\n      };\n\n      mockDatabase.getAgentPrompt.mockResolvedValue(mockPromptWithStringDate);\n\n      // 这应该不会抛出 \"getTime is not a function\" 错误\n      const result = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      \n      expect(result).toBeDefined();\n      expect(result.id).toBe('test-id');\n    });\n\n    test('should handle Date object from database', async () => {\n      // 模拟数据库返回Date对象\n      const mockPromptWithDateObject: AgentPromptData = {\n        id: 'test-id',\n        agent_type: 'chat_bot', \n        prompt_name: 'default_chat',\n        system_instructions: ['Test instruction'],\n        model_config: {\n          temperature: 0.7,\n          topK: 40,\n          topP: 0.95,\n          maxOutputTokens: 4096\n        },\n        is_active: true,\n        version: 1,\n        created_by: 'system',\n        created_at: new Date('2025-09-01T10:00:00.000Z'),\n        updated_at: new Date('2025-09-01T10:00:00.000Z'), // Date对象\n        description: 'Test prompt'\n      };\n\n      mockDatabase.getAgentPrompt.mockResolvedValue(mockPromptWithDateObject);\n\n      // 这应该正常工作\n      const result = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      \n      expect(result).toBeDefined();\n      expect(result.id).toBe('test-id');\n    });\n\n    test('should use cache correctly with string date', async () => {\n      const mockPromptWithStringDate: AgentPromptData = {\n        id: 'test-id',\n        agent_type: 'chat_bot',\n        prompt_name: 'default_chat',\n        system_instructions: ['Test instruction'],\n        model_config: {\n          temperature: 0.7,\n          topK: 40,\n          topP: 0.95,\n          maxOutputTokens: 4096\n        },\n        is_active: true,\n        version: 1,\n        created_by: 'system',\n        created_at: new Date('2025-09-01T10:00:00.000Z'),\n        updated_at: new Date().toISOString() as any, // 最近的字符串时间\n        description: 'Test prompt'\n      };\n\n      mockDatabase.getAgentPrompt.mockResolvedValue(mockPromptWithStringDate);\n\n      // 第一次调用\n      const result1 = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      \n      // 第二次调用应该使用缓存\n      const result2 = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      \n      expect(result1).toBeDefined();\n      expect(result2).toBeDefined();\n      expect(result1.id).toBe(result2.id);\n      \n      // 数据库应该只被调用一次（第二次使用缓存）\n      expect(mockDatabase.getAgentPrompt).toHaveBeenCalledTimes(1);\n    });\n\n    test('should expire cache correctly with string date', async () => {\n      // 设置一个很短的缓存超时时间用于测试\n      const originalCacheTimeout = (aiService as any).cacheTimeout;\n      (aiService as any).cacheTimeout = 100; // 100ms\n\n      const mockPromptWithOldStringDate: AgentPromptData = {\n        id: 'test-id',\n        agent_type: 'chat_bot',\n        prompt_name: 'default_chat',\n        system_instructions: ['Test instruction'],\n        model_config: {\n          temperature: 0.7,\n          topK: 40,\n          topP: 0.95,\n          maxOutputTokens: 4096\n        },\n        is_active: true,\n        version: 1,\n        created_by: 'system',\n        created_at: new Date('2025-09-01T10:00:00.000Z'),\n        updated_at: new Date(Date.now() - 200).toISOString() as any, // 200ms前的时间\n        description: 'Test prompt'\n      };\n\n      mockDatabase.getAgentPrompt.mockResolvedValue(mockPromptWithOldStringDate);\n\n      // 第一次调用\n      const result1 = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      \n      // 等待缓存过期\n      await new Promise(resolve => setTimeout(resolve, 150));\n      \n      // 第二次调用应该重新从数据库获取\n      const result2 = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      \n      expect(result1).toBeDefined();\n      expect(result2).toBeDefined();\n      \n      // 数据库应该被调用两次（缓存过期）\n      expect(mockDatabase.getAgentPrompt).toHaveBeenCalledTimes(2);\n\n      // 恢复原始缓存超时时间\n      (aiService as any).cacheTimeout = originalCacheTimeout;\n    });\n  });\n\n  describe('Regression Tests for cached.updated_at.getTime Error', () => {\n    test('should not throw getTime error with various date formats', async () => {\n      const dateFormats = [\n        '2025-09-01T10:00:00.000Z',      // ISO字符串\n        '2025-09-01 10:00:00',           // SQL日期格式\n        1725177600000,                   // Unix时间戳\n        new Date(),                      // Date对象\n      ];\n\n      for (const dateFormat of dateFormats) {\n        const mockPrompt: AgentPromptData = {\n          id: 'test-id',\n          agent_type: 'chat_bot',\n          prompt_name: 'default_chat',\n          system_instructions: ['Test'],\n          model_config: { temperature: 0.7, topK: 40, topP: 0.95, maxOutputTokens: 4096 },\n          is_active: true,\n          version: 1,\n          created_by: 'system',\n          created_at: new Date(),\n          updated_at: dateFormat as any,\n          description: 'Test'\n        };\n\n        mockDatabase.getAgentPrompt.mockResolvedValue(mockPrompt);\n\n        // 这些都不应该抛出错误\n        await expect((aiService as any).getAgentPrompt('chat_bot', 'default_chat'))\n          .resolves.toBeDefined();\n      }\n    });\n\n    test('should handle invalid date strings gracefully', async () => {\n      const mockPromptWithInvalidDate: AgentPromptData = {\n        id: 'test-id',\n        agent_type: 'chat_bot',\n        prompt_name: 'default_chat',\n        system_instructions: ['Test'],\n        model_config: { temperature: 0.7, topK: 40, topP: 0.95, maxOutputTokens: 4096 },\n        is_active: true,\n        version: 1,\n        created_by: 'system',\n        created_at: new Date(),\n        updated_at: 'invalid-date-string' as any,\n        description: 'Test'\n      };\n\n      mockDatabase.getAgentPrompt.mockResolvedValue(mockPromptWithInvalidDate);\n\n      // 即使日期字符串无效，也应该能处理（fallback到当前时间或跳过缓存）\n      const result = await (aiService as any).getAgentPrompt('chat_bot', 'default_chat');\n      expect(result).toBeDefined();\n    });\n  });\n});\n\n// 集成测试：验证完整的AI服务工作流程\ndescribe('AI Service Integration Test - Post Fix', () => {\n  test('should process conversation without cached date errors', async () => {\n    // 这个测试需要真实的数据库连接，但可以作为手动集成测试的参考\n\n    // 1. 发送测试消息\n    // curl -X POST http://localhost:8080/api/send_private \\\n    //   -H \"Content-Type: application/json\" \\\n    //   -d '{\"user_id\": 85178516, \"message\": \"测试修复后的AI回复\"}'\n\n    // 2. 验证响应不是\"无法处理\"\n    // curl 'http://localhost:8080/api/conversations?user_id=85178516&limit=1'\n\n    // 3. 检查日志中没有getTime错误\n    // tail logs/ai-service_$(date +%Y-%m-%d).log | grep -v \"getTime is not a function\"\n\n    expect(true).toBe(true); // 占位符，实际需要集成环境运行\n  });\n});\n\nexport {};","structuredPatch":[]}}
