{"extra":{"error":{"code":"ER_NO_SUCH_TABLE","errno":1146,"message":"Table 'qqbot_db.group_chat_settings' doesn't exist","sql":"\n        SELECT \n          gcs.group_id,\n          gcs.group_name,\n          COALESCE(SUM(gst.message_count), 0) as message_count,\n          COALESCE(SUM(gst.ai_responses), 0) as ai_responses\n        FROM group_chat_settings gcs\n        LEFT JOIN group_chat_stats gst ON gcs.group_id = gst.group_id \n          AND gst.date >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)\n        WHERE gcs.is_enabled = 1\n        GROUP BY gcs.group_id, gcs.group_name\n        HAVING message_count > 0\n        ORDER BY message_count DESC, ai_responses DESC\n        LIMIT 5\n      ","sqlMessage":"Table 'qqbot_db.group_chat_settings' doesn't exist","sqlState":"42S02"},"query":"\n        SELECT \n          gcs.group_id,\n          gcs.group_name,\n          COALESCE(SUM(gst.message_count), 0) as message_count,\n          COALESCE(SUM(gst.ai_responses), 0) as ai_responses\n        FROM group_chat_settings gcs\n        LEFT JOIN group_chat_stats gst ON gcs.group_id = gst.group_id \n          AND gst.date >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)\n        WHERE gcs.is_enabled = 1\n        GROUP BY gcs.group_id, gcs.group_name\n        HAVING message_count > 0\n        ORDER BY message_count DESC, ai_responses DESC\n        LIMIT 5\n      "},"level":"error","message":"Query execution failed","module":"database","timestamp":"2025-09-02T15:15:33.693Z"}
