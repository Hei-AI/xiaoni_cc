# Admin Panel Backend Environment Variables

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=qqbot_user
DB_PASSWORD=qqbot_password
DB_NAME=qqbot_db

# 服务端口
ADMIN_PORT=9080
HTTP_PORT=9080

# QQBot Core服务地址 (用于队列监控)
QQBOT_CORE_URL=http://localhost:8081

# 日志配置
LOG_LEVEL=info
LOG_DIR=./resources/logs

# 安全配置
JWT_SECRET=your-jwt-secret-key
BCRYPT_ROUNDS=10

# 文件上传
UPLOAD_DIR=./resources/uploads
MAX_FILE_SIZE=10MB