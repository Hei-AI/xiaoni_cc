[Unit]
Description=mitmproxy Transparent Proxy for QQ Bot
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=liahua
WorkingDirectory=/home/liahua/IdeaProject/qq_bot
Environment="PATH=/home/liahua/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/usr/local/lib/python3.10/dist-packages:/usr/lib/python3/dist-packages"

# 启动mitmproxy（使用Python CLI工具）
ExecStart=/usr/bin/python3 /home/liahua/IdeaProject/qq_bot/modules/http-traffic-monitor/transparent-proxy/mitmproxy_manager.py start --iptables

# 停止mitmproxy（使用Python CLI工具）
ExecStop=/usr/bin/python3 /home/liahua/IdeaProject/qq_bot/modules/http-traffic-monitor/transparent-proxy/mitmproxy_manager.py stop --cleanup

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
