# ---- Server ----
BRIDGE_PORT=8090
LOG_LEVEL=info

# ---- OneBot (NapCat/go-cqhttp compatible) ----
# API base URL for sending outbound messages
ONEBOT_API_BASE_URL=http://127.0.0.1:3000
# Optional access token (if OneBot API has auth)
ONEBOT_ACCESS_TOKEN=
# Bot qq id (for @ mention detection in group)
ONEBOT_SELF_ID=

# ---- OpenClaw Gateway ----
OPENCLAW_BASE_URL=http://127.0.0.1:18789
# Required. gateway auth token/password value
OPENCLAW_TOKEN=
# Target agent
OPENCLAW_AGENT_ID=main
# openresponses | chatcompletions
OPENCLAW_API_MODE=openresponses

# ---- Routing ----
# qq:<message_type>:<id>
SESSION_PREFIX=qq
# Process group messages only when bot is @
GROUP_REQUIRE_AT=true
# Optional comma-separated allowlists; empty means no restriction
GROUP_WHITELIST=
USER_WHITELIST=

# Optional prefix to trigger in group even without @ (example: /oc)
GROUP_TRIGGER_PREFIX=/oc
