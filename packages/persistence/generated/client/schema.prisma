generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GroupChatSetting {
  group_id                    BigInt    @id @db.BigInt
  group_name                  String?
  is_enabled                  Int       @default(1)
  continuous_learning_enabled Int       @default(1)
  auto_reply_enabled          Int       @default(0)
  transcript_compact_offset   Int       @default(6)
  welcome_message             String?
  admin_user_id               BigInt?   @db.BigInt
  agent_prompt_id             String?
  last_activity               DateTime? @db.Timestamp(3)
  created_at                  DateTime  @default(now()) @db.Timestamp(3)
  updated_at                  DateTime  @updatedAt @db.Timestamp(3)

  @@map("group_chat_settings")
}

model PrivateChatSetting {
  user_id                     BigInt    @id @db.BigInt
  username                    String?
  is_enabled                  Int       @default(1)
  continuous_learning_enabled Int       @default(1)
  auto_reply_enabled          Int       @default(0)
  transcript_compact_offset   Int       @default(6)
  welcome_message             String?
  user_notes                  String?
  agent_prompt_id             String?
  last_activity               DateTime? @db.Timestamp(3)
  created_at                  DateTime  @default(now()) @db.Timestamp(3)
  updated_at                  DateTime  @updatedAt @db.Timestamp(3)

  @@map("private_chat_settings")
}

model AgentInboundMessage {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  trace_id          String    @db.VarChar(128)
  source            String    @db.VarChar(32)
  message_sid       String    @db.VarChar(191)
  dedupe_key        String    @unique @db.VarChar(255)
  chat_type         String    @db.VarChar(16)
  session_key       String    @db.VarChar(191)
  peer_id           String    @db.VarChar(191)
  peer_name         String?   @db.VarChar(255)
  sender_id         String    @db.VarChar(191)
  sender_name       String?   @db.VarChar(255)
  account_id        String    @db.VarChar(191)
  is_read           Int       @default(0)
  read_at           DateTime? @db.Timestamp(3)
  received_at       DateTime  @db.Timestamp(3)
  message_timestamp DateTime? @db.Timestamp(3)
  body_for_agent    String
  raw_body          String?
  command_body      String?
  was_mentioned     Int       @default(0)
  reply_to_id       String?   @db.VarChar(191)
  reply_to_body     String?
  reply_to_sender   String?   @db.VarChar(255)
  raw_payload       Json
  inbound_context   Json
  created_at        DateTime  @default(now()) @db.Timestamp(3)
  updated_at        DateTime  @updatedAt @db.Timestamp(3)

  @@index([session_key, received_at, id], map: "idx_agent_inbound_messages_session_received")
  @@index([is_read, session_key, received_at, id], map: "idx_agent_inbound_messages_unread_session")
  @@index([message_sid], map: "idx_agent_inbound_messages_message_sid")
  @@index([chat_type, peer_id, received_at, id], map: "idx_agent_inbound_messages_peer")
  @@map("agent_inbound_messages")
}

model HttpTrafficLog {
  id                    BigInt    @id @default(autoincrement()) @db.BigInt
  request_id            String?   @db.VarChar(100)
  trace_id              String?   @db.VarChar(100)
  conversation_id       BigInt?   @db.BigInt
  user_id               String?   @db.VarChar(100)
  session_id            String?   @db.VarChar(100)
  agent_turn            Int?
  llm_call_id           String?   @db.VarChar(100)
  tool_call_id          String?   @db.VarChar(100)
  container_name        String?   @db.VarChar(100)
  service_name          String?   @db.VarChar(100)
  method                String    @db.VarChar(16)
  url                   String    @db.Text
  host                  String    @db.VarChar(255)
  path                  String    @db.Text
  query_params          Json?
  request_headers       Json
  request_body          String?   @db.Text
  request_content_type  String?   @db.VarChar(255)
  request_size          Int?
  response_status       Int?
  response_headers      Json?
  response_body         String?   @db.Text
  response_content_type String?   @db.VarChar(255)
  response_size         Int?
  duration_ms           BigInt?   @db.BigInt
  request_timestamp     DateTime  @db.Timestamp(3)
  response_timestamp    DateTime? @db.Timestamp(3)
  is_ai_request         Boolean   @default(false)
  api_type              String?   @db.VarChar(64)
  api_version           String?   @db.VarChar(32)
  client_ip             String?   @db.VarChar(128)
  user_agent            String?   @db.Text
  error_message         String?   @db.Text
  created_at            DateTime  @default(now()) @db.Timestamp(3)

  @@map("http_traffic_logs")
}

model ConversationItem {
  id                  BigInt   @id @default(autoincrement()) @db.BigInt
  conversation_id     BigInt   @db.BigInt
  session_key         String?  @db.VarChar(191)
  role                String   @db.VarChar(16)
  phase               String?  @db.VarChar(32)
  content             String
  group_index         Int      @default(0)
  item_index          Int      @default(0)
  source              String   @db.VarChar(32)
  delivery_message_id BigInt?  @db.BigInt
  run_id              String?  @db.VarChar(128)
  trace_id            String?  @db.VarChar(128)
  created_at          DateTime @default(now()) @db.Timestamp(3)

  @@index([conversation_id, group_index, item_index, id], map: "idx_conversation_items_conversation_group_item")
  @@index([session_key, created_at, id], map: "idx_conversation_items_session_created")
  @@map("conversation_items")
}

model TrafficReplayHistory {
  id                      BigInt   @id @default(autoincrement()) @db.BigInt
  original_log_id         BigInt   @db.BigInt
  replay_name             String?  @db.VarChar(255)
  target_url              String?  @db.Text
  request_method          String?  @db.VarChar(16)
  request_headers         Json?
  request_body            String?  @db.Text
  response_status         Int?
  response_headers        Json?
  response_body           String?  @db.Text
  duration_ms             Int?
  status                  String   @default("completed") @db.VarChar(32)
  error_message           String?  @db.Text
  replayed_at             DateTime @default(now()) @db.Timestamp(3)
  replayed_by             String?  @db.VarChar(50)
  modified_method         String?  @db.VarChar(16)
  modified_url            String?  @db.Text
  modified_headers        Json?
  modified_body           String?  @db.Text
  modification_summary    Json?
  replay_request_headers  Json?
  replay_request_body     String?  @db.Text
  replay_response_status  Int?
  replay_duration_ms      Int?
  replay_response_headers Json?
  replay_response_body    String?  @db.Text
  replay_response_size    Int?
  diff_summary            Json?
  status_code_match       Boolean  @default(false)
  response_body_match     Boolean  @default(false)
  duration_diff_ms        Int?
  body_size_diff          Int?
  success                 Boolean  @default(true)
  template_id             Int?

  @@index([original_log_id, replayed_at, id], map: "idx_original_log_replayed_at_id")
  @@map("traffic_replay_history")
}

model RelationshipLedgerEvent {
  id                 BigInt    @id @default(autoincrement()) @db.BigInt
  group_id           BigInt?   @db.BigInt
  target_user_id     BigInt?   @db.BigInt
  session_key        String    @db.VarChar(191)
  event_type         String    @db.VarChar(64)
  event_weight       Float     @default(0)
  confidence         String    @default("medium") @db.VarChar(16)
  source_message_ids Json
  source_excerpt     String?
  metadata           Json?
  created_at         DateTime  @default(now()) @db.Timestamp(3)
  last_reinforced_at DateTime? @db.Timestamp(3)

  @@index([group_id, target_user_id, event_type, created_at], map: "idx_relationship_ledger_scope_type_created")
  @@index([session_key, created_at], map: "idx_relationship_ledger_session_created")
  @@map("relationship_ledger_events")
}

model RelationshipMemoryJob {
  id                  BigInt    @id @default(autoincrement()) @db.BigInt
  group_id            BigInt?   @db.BigInt
  session_key         String    @db.VarChar(191)
  status              String    @db.VarChar(16)
  trigger_reason      String    @db.VarChar(64)
  turn_range_start    BigInt?   @db.BigInt
  turn_range_end      BigInt?   @db.BigInt
  ledger_event_count  Int       @default(0)
  input_message_ids   Json
  output_card_version Int?
  error_message       String?
  metadata            Json?
  started_at          DateTime? @db.Timestamp(3)
  finished_at         DateTime? @db.Timestamp(3)
  created_at          DateTime  @default(now()) @db.Timestamp(3)
  updated_at          DateTime  @updatedAt @db.Timestamp(3)

  @@index([group_id, status, updated_at], map: "idx_relationship_memory_jobs_group_status_updated")
  @@index([session_key, updated_at], map: "idx_relationship_memory_jobs_session_updated")
  @@map("relationship_memory_jobs")
}

model RelationshipMemoryCard {
  id                 BigInt    @id @default(autoincrement()) @db.BigInt
  card_type          String    @db.VarChar(32)
  group_id           BigInt?   @db.BigInt
  target_user_id     BigInt?   @db.BigInt
  version            Int       @default(1)
  is_active          Boolean   @default(true)
  summary_text       String
  actors             Json
  context_before     String?
  trigger            String?
  interaction        String?
  outcome            String?
  source_event_ids   Json
  source_message_ids Json
  importance_score   Float     @default(0)
  freshness_score    Float     @default(0)
  decayed_score      Float     @default(0)
  retrieval_text     String?
  embedding_text     String?
  last_hit_at        DateTime? @db.Timestamp(3)
  metadata           Json?
  created_at         DateTime  @default(now()) @db.Timestamp(3)
  updated_at         DateTime  @updatedAt @db.Timestamp(3)

  @@index([group_id, target_user_id, card_type, is_active, decayed_score], map: "idx_relationship_memory_cards_scope_active_score")
  @@index([group_id, is_active, updated_at], map: "idx_relationship_memory_cards_group_active_updated")
  @@map("relationship_memory_cards")
}

model RelationshipMemoryOverride {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  card_id     BigInt   @db.BigInt
  action_type String   @db.VarChar(32)
  manual_note String?
  created_by  String?  @db.VarChar(191)
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamp(3)

  @@index([card_id, created_at], map: "idx_relationship_memory_overrides_card_created")
  @@map("relationship_memory_overrides")
}

model ChatSpaceTopic {
  id                           BigInt    @id @default(autoincrement()) @db.BigInt
  chat_space_type              String    @db.VarChar(16)
  chat_space_id                BigInt    @db.BigInt
  status                       String    @default("candidate") @db.VarChar(32)
  canonical_title              String?
  started_at                   DateTime? @db.Timestamp(3)
  last_activity_at             DateTime? @db.Timestamp(3)
  closed_at                    DateTime? @db.Timestamp(3)
  current_accepted_version_id  BigInt?   @db.BigInt
  current_candidate_version_id BigInt?   @db.BigInt
  last_projection_job_id       BigInt?   @db.BigInt
  metadata                     Json?
  created_at                   DateTime  @default(now()) @db.Timestamp(3)
  updated_at                   DateTime  @updatedAt @db.Timestamp(3)

  @@index([chat_space_type, chat_space_id, status, last_activity_at], map: "idx_chat_space_topics_space_status_activity")
  @@index([chat_space_type, chat_space_id, updated_at], map: "idx_chat_space_topics_space_updated")
  @@map("chat_space_topics")
}

model TopicProjectionJob {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  chat_space_type   String    @db.VarChar(16)
  chat_space_id     BigInt    @db.BigInt
  trigger_type      String    @db.VarChar(32)
  status            String    @db.VarChar(32)
  input_bundle_json Json
  input_bundle_hash String    @db.VarChar(191)
  base_version_ids  Json
  model_name        String?   @db.VarChar(191)
  model_config_json Json?
  prompt_version    String?   @db.VarChar(191)
  error_code        String?   @db.VarChar(64)
  error_message     String?
  metadata          Json?
  started_at        DateTime? @db.Timestamp(3)
  finished_at       DateTime? @db.Timestamp(3)
  created_at        DateTime  @default(now()) @db.Timestamp(3)
  updated_at        DateTime  @updatedAt @db.Timestamp(3)

  @@index([chat_space_type, chat_space_id, status, updated_at], map: "idx_topic_projection_jobs_space_status_updated")
  @@index([input_bundle_hash, created_at], map: "idx_topic_projection_jobs_bundle_hash")
  @@map("topic_projection_jobs")
}

model TopicProjectionVersion {
  id                    BigInt    @id @default(autoincrement()) @db.BigInt
  topic_id              BigInt    @db.BigInt
  projection_job_id     BigInt?   @db.BigInt
  version_number        Int
  status                String    @default("candidate") @db.VarChar(32)
  lifecycle_state       String    @default("candidate") @db.VarChar(32)
  title                 String?
  summary_text          String
  review_priority_score Float     @default(0)
  heat_score            Float     @default(0)
  participant_ids       Json
  topic_keywords        Json
  evidence_count        Int       @default(0)
  relationship_count    Int       @default(0)
  runtime_hit_count     Int       @default(0)
  last_runtime_hit_at   DateTime? @db.Timestamp(3)
  input_bundle_hash     String    @db.VarChar(191)
  snapshot_json         Json
  provenance_json       Json
  metadata              Json?
  created_at            DateTime  @default(now()) @db.Timestamp(3)
  updated_at            DateTime  @updatedAt @db.Timestamp(3)

  @@unique([topic_id, version_number], map: "uniq_topic_projection_versions_topic_version")
  @@index([topic_id, created_at], map: "idx_topic_projection_versions_topic_created")
  @@index([projection_job_id, created_at], map: "idx_topic_projection_versions_job_created")
  @@index([status, updated_at], map: "idx_topic_projection_versions_status_updated")
  @@map("topic_projection_versions")
}

model TopicVersionRelationship {
  id                    BigInt   @id @default(autoincrement()) @db.BigInt
  projection_version_id BigInt   @db.BigInt
  target_user_id        BigInt   @db.BigInt
  relationship_kind     String?  @db.VarChar(64)
  summary_text          String
  actors                Json
  source_event_ids      Json
  source_message_ids    Json
  metadata              Json?
  created_at            DateTime @default(now()) @db.Timestamp(3)

  @@index([projection_version_id, target_user_id], map: "idx_topic_version_relationships_version_target")
  @@map("topic_version_relationships")
}

model TopicVersionEvidence {
  id                    BigInt    @id @default(autoincrement()) @db.BigInt
  projection_version_id BigInt    @db.BigInt
  source_kind           String    @db.VarChar(32)
  source_id             BigInt    @db.BigInt
  sort_order            Int       @default(0)
  excerpt_text          String?
  speaker_id            String?   @db.VarChar(191)
  speaker_name          String?   @db.VarChar(255)
  occurred_at           DateTime? @db.Timestamp(3)
  metadata              Json?
  created_at            DateTime  @default(now()) @db.Timestamp(3)

  @@index([projection_version_id, sort_order, id], map: "idx_topic_version_evidence_version_sort")
  @@index([source_kind, source_id], map: "idx_topic_version_evidence_source")
  @@map("topic_version_evidence")
}

model TopicReviewEvent {
  id                           BigInt   @id @default(autoincrement()) @db.BigInt
  topic_id                     BigInt   @db.BigInt
  base_projection_version_id   BigInt?  @db.BigInt
  result_projection_version_id BigInt?  @db.BigInt
  action_type                  String   @db.VarChar(64)
  status                       String   @default("recorded") @db.VarChar(32)
  created_by                   String?  @db.VarChar(191)
  manual_note                  String?
  patch_json                   Json?
  metadata                     Json?
  created_at                   DateTime @default(now()) @db.Timestamp(3)
  updated_at                   DateTime @updatedAt @db.Timestamp(3)

  @@index([topic_id, created_at], map: "idx_topic_review_events_topic_created")
  @@index([status, updated_at], map: "idx_topic_review_events_status_updated")
  @@map("topic_review_events")
}

model GoldenChatCase {
  id                           BigInt   @id @default(autoincrement()) @db.BigInt
  chat_space_type              String   @db.VarChar(16)
  chat_space_id                BigInt   @db.BigInt
  topic_id                     BigInt?  @db.BigInt
  source_projection_version_id BigInt   @db.BigInt
  label                        String?  @db.VarChar(255)
  status                       String   @default("active") @db.VarChar(32)
  input_bundle_hash            String   @db.VarChar(191)
  expected_snapshot_json       Json
  fixture_bundle_json          Json
  created_by                   String?  @db.VarChar(191)
  metadata                     Json?
  created_at                   DateTime @default(now()) @db.Timestamp(3)
  updated_at                   DateTime @updatedAt @db.Timestamp(3)

  @@index([chat_space_type, chat_space_id, status, updated_at], map: "idx_golden_chat_cases_space_status_updated")
  @@index([source_projection_version_id, created_at], map: "idx_golden_chat_cases_source_version")
  @@map("golden_chat_cases")
}
