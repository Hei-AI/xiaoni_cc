generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentQueueMessage {
  id                    BigInt    @id @default(autoincrement()) @db.BigInt
  trace_id              String    @db.VarChar(128)
  batch_id              String?   @db.VarChar(128)
  run_id                String?   @db.VarChar(128)
  source                String    @db.VarChar(32)
  message_sid           String    @db.VarChar(191)
  dedupe_key            String    @unique @db.VarChar(255)
  chat_type             String    @db.VarChar(16)
  session_key           String    @db.VarChar(191)
  peer_id               String    @db.VarChar(191)
  peer_name             String?   @db.VarChar(255)
  sender_id             String    @db.VarChar(191)
  sender_name           String?   @db.VarChar(255)
  account_id            String    @db.VarChar(191)
  body_for_agent        String
  raw_payload           Json      @default("{}")
  inbound_context       Json      @default("{}")
  payload               Json      @default("{}")
  status                String    @default("pending") @db.VarChar(16)
  attempts              Int       @default(0)
  max_attempts          Int       @default(3)
  available_at          DateTime  @default(now()) @db.Timestamptz(3)
  locked_at             DateTime? @db.Timestamptz(3)
  locked_by             String?   @db.VarChar(128)
  processing_started_at DateTime? @db.Timestamptz(3)
  completed_at          DateTime? @db.Timestamptz(3)
  error_message         String?
  result                Json?
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  updated_at            DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, available_at, id], map: "idx_agent_queue_pending_available")
  @@index([session_key, status, available_at, id], map: "idx_agent_queue_session_pending")
  @@index([trace_id, created_at, id], map: "idx_agent_queue_trace_created")
  @@index([source, id], map: "idx_agent_queue_phone_notification_source_id")
  @@map("agent_queue_messages")
}

