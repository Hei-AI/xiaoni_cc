  delivery_message_id String?  @db.VarChar(191)
  content_kind        String   @default("text") @db.VarChar(16)
  body_for_agent      String
  raw_body            String?
  reply_to_id         String?  @db.VarChar(191)
  reply_to_body       String?
  reply_to_sender     String?  @db.VarChar(255)
  sent_at             DateTime @db.Timestamptz(3)
  trace_id            String?  @db.VarChar(128)
  run_id              String?  @db.VarChar(128)
  created_at          DateTime @default(now()) @db.Timestamptz(3)

