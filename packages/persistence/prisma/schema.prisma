  @@index([status, available_at, id], map: "idx_agent_tasks_status_available")
  @@index([session_key, created_at, id], map: "idx_agent_tasks_session_created")
  @@index([source_trace_id], map: "idx_agent_tasks_trace")
  @@map("agent_tasks")
}

model AgentTaskArtifact {
  id             String    @id @db.VarChar(64)
  task_id        String    @db.VarChar(64)
  kind           String    @default("image") @db.VarChar(32)
  file_path      String?   @db.Text
  public_path    String?   @db.Text
  data_url       String?   @db.Text
  mime_type      String?   @db.VarChar(128)
  format         String?   @db.VarChar(16)
  bytes          Int?
  revised_prompt String?   @db.Text
  metadata       Json?
  created_at     DateTime  @default(now()) @db.Timestamp(3)
  task           AgentTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id, created_at], map: "idx_agent_task_artifacts_task_created")
  @@map("agent_task_artifacts")
}

