{
  "name": "qq-bot-project",
  "version": "1.0.0",
  "description": "QQ智能机器人 - 核心服务与管理端",
  "private": true,
  "scripts": {
    "prestart": "python3 scripts/start_modules.py install",
    "start": "python3 scripts/start_modules.py start",
    "start:fast": "python3 scripts/start_modules.py start",
    "stop": "python3 scripts/start_modules.py stop",
    "restart": "python3 scripts/start_modules.py restart",
    "status": "python3 scripts/start_modules.py status",
    "build": "npm run build:qqbot-core && npm run build:admin-backend && npm run build:admin-frontend",
    "clean": "npm run clean:qqbot-core && npm run clean:admin-backend && npm run clean:admin-frontend",
    "test": "npm run test:qqbot-core && npm run test:admin-backend && npm run test:admin-frontend",
    "lint": "npm run lint:qqbot-core && npm run lint:admin-backend",
    "install:all": "python3 scripts/start_modules.py install",
    "install:root": "npm ci --no-audit --no-fund",
    "install:qqbot-core": "npm --prefix modules/qqbot-core ci --include=dev --no-audit --no-fund",
    "install:admin-backend": "npm --prefix modules/admin-panel/backend ci --include=dev --no-audit --no-fund",
    "install:admin-frontend": "npm --prefix modules/admin-panel/frontend ci --include=dev --no-audit --no-fund",
    "dev": "python3 scripts/start_modules.py start",
    "dev:qqbot-core": "npm --prefix modules/qqbot-core run dev",
    "dev:admin-backend": "npm --prefix modules/admin-panel/backend run dev",
    "dev:admin-frontend": "npm --prefix modules/admin-panel/frontend run dev",
    "build:all": "npm run build",
    "build:qqbot-core": "npm --prefix modules/qqbot-core run build",
    "build:admin-backend": "npm --prefix modules/admin-panel/backend run build",
    "build:admin-frontend": "npm --prefix modules/admin-panel/frontend run build",
    "clean:all": "npm run clean",
    "clean:qqbot-core": "npm --prefix modules/qqbot-core run clean",
    "clean:admin-backend": "npm --prefix modules/admin-panel/backend run clean",
    "clean:admin-frontend": "npm --prefix modules/admin-panel/frontend run clean",
    "test:all": "npm run test",
    "test:qqbot-core": "npm --prefix modules/qqbot-core test",
    "test:admin-backend": "npm --prefix modules/admin-panel/backend test",
    "test:admin-frontend": "npm --prefix modules/admin-panel/frontend test",
    "lint:all": "npm run lint",
    "lint:qqbot-core": "npm --prefix modules/qqbot-core run lint",
    "lint:admin-backend": "npm --prefix modules/admin-panel/backend run lint",
    "clean-ports": "python3 scripts/start_modules.py clean-ports",
    "health-check": "python3 scripts/start_modules.py status",
    "deploy": "bash scripts/deploy-admin-public.sh",
    "deploy:local": "npm run stop && npm run install:all && npm run start",
    "deploy:admin-public": "bash scripts/deploy-admin-public.sh"
  },
  "keywords": [
    "qq-bot",
    "onebot",
    "microservices",
    "typescript",
    "ai-service"
  ],
  "author": "QQ Bot Team",
  "license": "MIT",
  "devDependencies": {
    "shadcn": "^3.2.1"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "colors": "^1.4.0",
    "mysql2": "^3.15.0",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0"
  }
}
