{
  "name": "qq-bot-project",
  "version": "1.0.0",
  "description": "QQ智能机器人 - 核心服务与管理端",
  "private": true,
  "scripts": {
    "prestart": "python3 scripts/start_modules.py install",
    "start": "python3 scripts/start_modules.py start",
    "start:fast": "python3 scripts/start_modules.py start",
    "stop": "python3 scripts/start_modules.py stop",
    "restart": "python3 scripts/start_modules.py restart",
    "status": "python3 scripts/start_modules.py status",
    "build": "npm run build:provider-service && npm run build:xiaoni-executor && npm run build:agent-service && npm run build:admin-backend && npm run build:admin-frontend",
    "clean": "npm run clean:provider-service && npm run clean:xiaoni-executor && npm run clean:agent-service && npm run clean:admin-backend && npm run clean:admin-frontend",
    "test": "npm run test:persistence && npm run test:provider-service && npm run test:xiaoni-executor && npm run test:agent-service && npm run test:admin-backend && npm run test:admin-frontend",
    "lint": "npm run lint:provider-service && npm run lint:agent-service && npm run lint:admin-backend && npm run lint:docs",
    "install:all": "python3 scripts/start_modules.py install",
    "install:root": "npm ci --no-audit --no-fund",
    "install:provider-service": "npm --prefix modules/provider-service ci --include=dev --no-audit --no-fund",
    "install:xiaoni-executor": "npm --prefix modules/xiaoni-executor ci --include=dev --no-audit --no-fund",
    "install:agent-service": "npm --prefix modules/agent-service ci --include=dev --no-audit --no-fund",
    "install:admin-backend": "npm --prefix modules/admin-panel/backend ci --include=dev --no-audit --no-fund",
    "install:admin-frontend": "npm --prefix modules/admin-panel/frontend ci --include=dev --no-audit --no-fund",
    "dev": "python3 scripts/start_modules.py start",
    "dev:provider-service": "npm --prefix modules/provider-service run dev",
    "dev:xiaoni-executor": "npm --prefix modules/xiaoni-executor run dev",
    "dev:agent-service": "npm --prefix modules/agent-service run dev",
    "dev:admin-backend": "npm --prefix modules/admin-panel/backend run dev",
    "dev:admin-frontend": "npm --prefix modules/admin-panel/frontend run dev",
    "build:all": "npm run build",
    "build:provider-service": "npm --prefix modules/provider-service run build",
    "build:xiaoni-executor": "npm --prefix modules/xiaoni-executor run build",
    "build:agent-service": "npm --prefix modules/agent-service run build",
    "build:admin-backend": "npm --prefix modules/admin-panel/backend run build",
    "build:admin-frontend": "npm --prefix modules/admin-panel/frontend run build",
    "clean:all": "npm run clean",
    "clean:provider-service": "npm --prefix modules/provider-service run clean",
    "clean:xiaoni-executor": "npm --prefix modules/xiaoni-executor run clean",
    "clean:agent-service": "npm --prefix modules/agent-service run clean",
    "clean:admin-backend": "npm --prefix modules/admin-panel/backend run clean",
    "clean:admin-frontend": "npm --prefix modules/admin-panel/frontend run clean",
    "test:all": "npm run test",
    "test:persistence": "npm --prefix packages/persistence test",
    "test:provider-service": "npm --prefix modules/provider-service test",
    "test:xiaoni-executor": "npm --prefix modules/xiaoni-executor test",
    "test:agent-service": "npm --prefix modules/agent-service test",
    "test:admin-backend": "npm --prefix modules/admin-panel/backend test",
    "test:admin-frontend": "npm --prefix modules/admin-panel/frontend test",
    "lint:all": "npm run lint",
    "lint:docs": "python3 scripts/validate_docs.py",
    "lint:provider-service": "npm --prefix modules/provider-service run lint",
    "lint:agent-service": "npm --prefix modules/agent-service run lint",
    "lint:admin-backend": "npm --prefix modules/admin-panel/backend run lint",
    "clean-ports": "python3 scripts/start_modules.py clean-ports",
    "health-check": "python3 scripts/start_modules.py status",
    "deploy": "bash scripts/deploy-admin-public.sh",
    "deploy:local": "npm run stop && npm run install:all && npm run start",
    "deploy:admin-public": "bash scripts/deploy-admin-public.sh"
  },
  "keywords": [
    "qq-bot",
    "onebot",
    "microservices",
    "typescript",
    "ai-service"
  ],
  "author": "QQ Bot Team",
  "license": "MIT",
  "devDependencies": {
    "shadcn": "^3.2.1"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "colors": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0"
  }
}
