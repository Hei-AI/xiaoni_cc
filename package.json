{
  "name": "qq-bot-project",
  "version": "1.0.0",
  "description": "QQ智能机器人 - 4模块微服务架构",
  "private": true,
  "scripts": {
    "prestart": "python3 scripts/start_modules.py install",
    "start": "python3 scripts/start_modules.py start",
    "start:fast": "python3 scripts/start_modules.py start",
    "stop": "python3 scripts/start_modules.py stop",
    "restart": "python3 scripts/start_modules.py restart",
    "status": "python3 scripts/start_modules.py status",
    "install:all": "python3 scripts/start_modules.py install",
    "install:http-api": "cd modules/http-api && npm install",
    "install:qqbot-core": "cd modules/qqbot-core && npm install",
    "install:admin-backend": "cd modules/admin-panel/backend && npm install",
    "install:admin-frontend": "cd modules/admin-panel/frontend && npm install",
    "dev": "python3 scripts/start_modules.py start",
    "dev:http-api": "cd modules/http-api && npm run dev",
    "dev:qqbot-core": "cd modules/qqbot-core && npm run dev",
    "dev:admin-backend": "cd modules/admin-panel/backend && npm run dev",
    "dev:admin-frontend": "cd modules/admin-panel/frontend && npm run dev",
    "build:all": "concurrently \"npm run build:http-api\" \"npm run build:qqbot-core\" \"npm run build:admin-backend\" \"npm run build:admin-frontend\"",
    "build:http-api": "cd modules/http-api && npm run build",
    "build:qqbot-core": "cd modules/qqbot-core && npm run build",
    "build:admin-backend": "cd modules/admin-panel/backend && npm run build",
    "build:admin-frontend": "cd modules/admin-panel/frontend && npm run build",
    "clean:all": "concurrently \"npm run clean:http-api\" \"npm run clean:qqbot-core\" \"npm run clean:admin-backend\" \"npm run clean:admin-frontend\"",
    "clean:http-api": "cd modules/http-api && npm run clean",
    "clean:qqbot-core": "cd modules/qqbot-core && npm run clean",
    "clean:admin-backend": "cd modules/admin-panel/backend && npm run clean",
    "clean:admin-frontend": "cd modules/admin-panel/frontend && npm run clean",
    "test:all": "concurrently \"npm run test:http-api\" \"npm run test:qqbot-core\" \"npm run test:admin-backend\" \"npm run test:admin-frontend\"",
    "test:http-api": "cd modules/http-api && npm test",
    "test:qqbot-core": "cd modules/qqbot-core && npm test",
    "test:admin-backend": "cd modules/admin-panel/backend && npm test",
    "test:admin-frontend": "cd modules/admin-panel/frontend && npm test",
    "lint:all": "concurrently \"npm run lint:http-api\" \"npm run lint:qqbot-core\" \"npm run lint:admin-backend\"",
    "lint:http-api": "cd modules/http-api && npm run lint",
    "lint:qqbot-core": "cd modules/qqbot-core && npm run lint",
    "lint:admin-backend": "cd modules/admin-panel/backend && npm run lint",
    "clean-ports": "python3 scripts/start_modules.py clean-ports",
    "health-check": "python3 scripts/start_modules.py status",
    "deploy": "npm run stop && npm run install:all && npm run start"
  },
  "workspaces": [
    "modules/http-api",
    "modules/qqbot-core",
    "modules/admin-panel/backend",
    "modules/admin-panel/frontend"
  ],
  "keywords": [
    "qq-bot",
    "onebot",
    "microservices",
    "typescript",
    "ai-service"
  ],
  "author": "QQ Bot Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "shadcn": "^3.2.1"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "colors": "^1.4.0",
    "mysql2": "^3.15.0",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0"
  }
}
